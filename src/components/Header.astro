---
import { site } from '../site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label={`${site.name} home`}>
      <img src="/images/logo.png" alt={site.name} width="1607" height="326" />
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="open">Menu</span><span class="close">Close</span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="cta"><a class="btn outline small" href="/chat">Book a Chat</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--white); border-bottom: 1px solid var(--line); position: relative; z-index: 20; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .logo img { height: 40px; width: auto; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: clamp(14px, 2vw, 28px); }
  .nav a:not(.btn) { text-decoration: none; font-size: .9rem; padding: .3em 0; border-bottom: 2px solid transparent; }
  .nav a:not(.btn):hover, .nav a[aria-current="page"] { border-bottom-color: var(--ink); }
  .menu-btn { display: none; font: inherit; font-size: .85rem; letter-spacing: .1em; text-transform: uppercase; background: none; border: 0; cursor: pointer; padding: .5em; }
  .menu-btn .close { display: none; }
  @media (max-width: 860px) {
    .menu-btn { display: block; }
    .nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--white); border-bottom: 1px solid var(--line); padding: 8px var(--gutter) 24px; }
    .nav ul { flex-direction: column; align-items: flex-start; gap: 4px; }
    .nav a:not(.btn) { display: block; font-size: 1.1rem; padding: .5em 0; }
    .nav .cta { margin-top: 12px; }
    .site-header.open .nav { display: block; }
    .site-header.open .menu-btn .open { display: none; }
    .site-header.open .menu-btn .close { display: inline; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const btn = header?.querySelector('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = header!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
