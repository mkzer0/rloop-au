---
import { site } from '../site';
const configured = site.buttondownUser && !site.buttondownUser.startsWith('YOUR_');
const action = `https://buttondown.com/api/emails/embed-subscribe/${site.buttondownUser}`;
const subject = encodeURIComponent('Sign me up for Re:Agile News');
---
{!configured && (
  <p><a class="btn" href={`mailto:${site.email}?subject=${subject}`}>Email to sign up</a></p>
)}

<div class="newsletter-wrap" hidden={!configured}>
  <form class="newsletter" action={action} method="post" target="_blank">
    <div class="grid-2">
      <div class="field">
        <label for="nl-first">First Name</label>
        <input id="nl-first" type="text" name="metadata__first_name" autocomplete="given-name" />
      </div>
      <div class="field">
        <label for="nl-last">Last Name</label>
        <input id="nl-last" type="text" name="metadata__last_name" autocomplete="family-name" />
      </div>
    </div>
    <div class="field">
      <label for="nl-email">Email Address <span class="req">(required)</span></label>
      <input id="nl-email" type="email" name="email" required autocomplete="email" />
    </div>
    <input type="hidden" name="tag" value="re-agile-news" />
    <p class="form-error" role="alert" hidden></p>
    <button class="btn" type="submit">Sign Up</button>
  </form>

  <div class="newsletter-thanks" role="status" aria-live="polite" hidden>
    <h3>Thank you!</h3>
    <p>Check your inbox for a confirmation email and click the link to complete your sign-up to Re:Agile News.</p>
  </div>
</div>

<style>
  .form-error { color: var(--accent); font-size: .95rem; margin: 0 0 1em; }
  .newsletter-thanks { border-top: 3px solid var(--accent); padding-top: 1.2em; }
  .btn[disabled] { opacity: .6; cursor: progress; }
</style>

<script>
  // Subscribe via Buttondown in the background and show the thank-you in place.
  // Without JavaScript the form posts normally and opens Buttondown's page.
  const wrap = document.querySelector<HTMLElement>('.newsletter-wrap');
  const form = wrap?.querySelector<HTMLFormElement>('form.newsletter');
  const thanks = wrap?.querySelector<HTMLElement>('.newsletter-thanks');
  const error = form?.querySelector<HTMLElement>('.form-error');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    error!.hidden = true;
    button!.disabled = true;
    button!.textContent = 'Signing up…';
    try {
      // Buttondown answers a successful subscription with a redirect to its
      // confirmation page; following it yields an ok response.
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), redirect: 'follow' });
      if (!res.ok && !res.redirected) throw new Error(`Request failed (${res.status})`);
      form.hidden = true;
      thanks!.hidden = false;
      (window as any).gtag?.('event', 'sign_up', { method: 'newsletter' });
    } catch (err) {
      const reason = err instanceof Error && err.message ? ` ${err.message.replace(/\.?$/, '.')}` : '';
      error!.textContent = `Sorry, the sign-up did not go through.${reason} Please try again in a moment.`;
      error!.hidden = false;
    } finally {
      button!.disabled = false;
      button!.textContent = 'Sign Up';
    }
  });
</script>
