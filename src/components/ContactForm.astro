---
import { site } from '../site';
const action = `https://formspree.io/f/${site.formspreeId}`;
const next = `${site.url}/thanks`;
---
<form class="contact" action={action} method="post">
  <input type="hidden" name="_subject" value="Book a Chat enquiry from recursiveloop.com.au" />
  <input type="hidden" name="_next" value={next} />
  <label class="hp" aria-hidden="true">Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>

  <div class="field">
    <label for="c-name">Name <span class="req">(required)</span></label>
    <input id="c-name" type="text" name="name" required autocomplete="name" />
  </div>
  <div class="field">
    <label for="c-email">Email <span class="req">(required)</span></label>
    <input id="c-email" type="email" name="email" required autocomplete="email" />
  </div>
  <div class="field inline">
    <input id="c-news" type="checkbox" name="newsletter" value="yes" />
    <label for="c-news">Sign up for news and updates</label>
  </div>
  <div class="field">
    <label for="c-subject">Subject <span class="req">(required)</span></label>
    <input id="c-subject" type="text" name="subject" required />
  </div>
  <fieldset class="field">
    <legend class="label">Services</legend>
    <div class="checks">
      <label><input type="checkbox" name="services" value="Coaching" /> Coaching</label>
      <label><input type="checkbox" name="services" value="Training" /> Training</label>
      <label><input type="checkbox" name="services" value="Facilitation" /> Facilitation</label>
    </div>
  </fieldset>
  <div class="field">
    <label for="c-message">Message <span class="req">(required)</span></label>
    <textarea id="c-message" name="message" required></textarea>
  </div>
  <button class="btn" type="submit">Submit</button>
</form>

<style>
  fieldset { border: 0; padding: 0; margin: 0 0 1.1em; }
  legend { padding: 0; margin-bottom: .35em; }
</style>
