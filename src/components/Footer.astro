---
import { site, mailto } from '../site';
const year = new Date().getFullYear();
const badges = [
  { src: '/images/1d00ad-authorized-instructor.png', alt: 'ICAgile Authorized Instructor' },
  { src: '/images/f180ac-icp-prg.png', alt: 'ICAgile Certified Professional in Agile Programming' },
  { src: '/images/cfd00b-icp.png', alt: 'ICAgile Certified Professional' },
  { src: '/images/3ce78d-ctc.png', alt: 'Scrum Alliance Certified Team Coach' },
];
---
<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <h2>Let’s chat</h2>
      <p><a href={mailto('Enquiry')}>{site.email}</a></p>
      <p class="muted">{site.location}</p>
      <ul class="social" aria-label="Social links">
        <li><a href={site.social.linkedin} aria-label="LinkedIn" rel="me">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a></li>
        <li><a href={site.social.twitter} aria-label="Twitter" rel="me">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z"/></svg>
        </a></li>
        <li><a href={site.social.github} aria-label="GitHub" rel="me">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
        </a></li>
      </ul>
    </div>
    <div class="badges" aria-label="Accreditations">
      {badges.map((b) => <img src={b.src} alt={b.alt} loading="lazy" />)}
    </div>
  </div>
  <div class="wrap fine">
    <p class="muted">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--light); border-top: 1px solid var(--line); padding: clamp(40px, 6vw, 72px) 0 24px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  h2 { font-size: 1.6rem; }
  p { margin-bottom: .3em; }
  .social { list-style: none; padding: 0; margin: 1.2em 0 0; display: flex; gap: 18px; }
  .social a { color: var(--ink); display: inline-flex; }
  .social a:hover { color: var(--accent); }
  .badges { display: flex; flex-wrap: wrap; gap: 20px; justify-content: flex-end; }
  .badges img { height: 90px; width: auto; }
  .fine { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); font-size: .85rem; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .badges { justify-content: flex-start; } .badges img { height: 72px; } }
</style>
