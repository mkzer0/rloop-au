---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist.">
  <section class="band">
    <div class="wrap"><h1>Page not found</h1></div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <p class="lede">We couldn’t find that page. It may have moved when the site was rebuilt.</p>
      <p><a class="btn outline" href="/">Back to home</a> &nbsp; <a class="btn outline" href="/insights">Read Insights</a></p>
    </div>
  </section>
</Base>
