---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('insights');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Adelaide' });
---
<Base title={post.data.title} description={post.data.description} image={post.data.image} type="article">
  <article>
    <header class="post-head">
      <div class="wrap">
        <p class="meta">{post.data.author} · <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time></p>
        <h1>{post.data.title}</h1>
      </div>
    </header>
    <div class="wrap">
      <img class="lead" src={post.data.image} alt="" />
      <div class="article">
        <Content />
      </div>
      <p class="back"><a href="/insights">← All insights</a></p>
    </div>
  </article>
</Base>

<style>
  .post-head { padding: clamp(40px, 6vw, 80px) 0 24px; }
  .post-head h1 { max-width: 20em; font-size: clamp(1.9rem, 4vw, 3rem); }
  .meta { color: var(--muted); font-size: .9rem; margin-bottom: .8em; }
  .lead { width: 100%; max-height: 520px; object-fit: cover; margin: 0 0 clamp(32px, 5vw, 56px); }
  .back { max-width: var(--prose); margin: 48px auto 72px; }
  .back a { text-decoration: none; font-weight: 500; }
  .back a:hover { color: var(--accent); }
</style>
