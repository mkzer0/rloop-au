---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Thanks for getting in touch with Recursive Loop.">
  <section class="band">
    <div class="wrap"><h1>Thank you!</h1></div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <p class="lede">Thank you for your interest! We’ll respond to your message within 3 business days.</p>
      <p>Warm Regards,<br />The Recursive Loop Team</p>
      <p><a class="btn outline" href="/">Back to home</a></p>
    </div>
  </section>
</Base>
